# Vendor / ignore large non-code directories from language stats
public/** linguist-vendored
assets-original/** linguist-vendored
download/** linguist-vendored
upload/** linguist-vendored
tests/** linguist-vendored
examples/** linguist-vendored
.zscripts/** linguist-vendored
*.mp4 linguist-vendored
*.webm linguist-vendored
*.gif linguist-vendored
bun.lock linguist-vendored

# Force TypeScript detection on all source code files
*.ts linguist-detectable
*.tsx linguist-detectable
*.ts linguist-language=TypeScript
*.tsx linguist-language=TypeScript
