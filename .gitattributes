# 1. Treat everything as vendored/ignored by default
* linguist-vendored

# 2. Specifically un-vendor and detect src code
src/** linguist-vendored=false
src/** linguist-detectable

# 3. Explicitly map extensions to TypeScript
*.ts linguist-detectable
*.tsx linguist-detectable
*.ts linguist-language=TypeScript
*.tsx linguist-language=TypeScript
